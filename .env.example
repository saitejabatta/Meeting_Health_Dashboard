# .env.example
# Copy this file to .env and fill in values for the features you use.

# OpenAI API key for structured briefing parsing and optional embeddings.
# Get it from https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Chat model used by the briefing parser.
OPENAI_BRIEFING_MODEL=gpt-4o-mini

# General fallback chat model name for future assistant features.
OPENAI_MODEL=gpt-4o-mini

# OpenAI embedding model used if the local sentence-transformers model is unavailable.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local sentence-transformers embedding model used for avoid-topic checks and background RAG.
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Set true to load LOCAL_EMBEDDING_MODEL. Leave false to use the offline deterministic fallback.
ENABLE_LOCAL_EMBEDDINGS=false

# Set true to use Chroma for background context. Leave false for the simple in-memory store.
ENABLE_CHROMA_VECTOR_STORE=false

# Timeout in seconds for LLM calls before rule-based fallback is used.
LLM_TIMEOUT_SECONDS=20

# Audio chunk length in seconds for live capture and transcription.
AUDIO_CHUNK_SECONDS=30

# Seconds of overlap between chunks so Whisper does not split sentences at boundaries.
AUDIO_OVERLAP_SECONDS=5

# Virtual audio input device for system audio capture.
# macOS example: BlackHole 2ch
# Windows example: CABLE Output (VB-Audio Virtual Cable)
# Linux example: meeting_monitor.monitor
VIRTUAL_AUDIO_DEVICE_NAME=BlackHole 2ch

# Whisper model size for live transcription.
WHISPER_MODEL=base

# faster-whisper device and compute type. Use cuda/float16 on supported GPUs.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Hugging Face token for pyannote speaker diarization.
# Get it from https://huggingface.co/settings/tokens and accept pyannote model terms.
HF_TOKEN=

# pyannote diarization model used for live speaker tracking.
PYANNOTE_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# Runtime memory comprehension interval in seconds.
MEMORY_UPDATE_INTERVAL_SECONDS=300

# OpenAI model used by runtime memory comprehension.
OPENAI_MEMORY_MODEL=gpt-4o-mini

# OpenAI model used by live agent response generation.
OPENAI_AGENT_MODEL=gpt-4o-mini

# OpenAI model used for optional real-time flag confirmation.
OPENAI_FLAG_MODEL=gpt-4o-mini

# ElevenLabs credentials for spoken responses in FULL_PROXY and PARTICIPATOR modes.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# RMS threshold below which the responder considers the room quiet.
SILENCE_RMS_THRESHOLD=350

# Directory where assistant recordings, transcripts, metadata, pipeline outputs, and reports are saved.
RECORDINGS_DIR=./recordings

# OpenAI model used by optional post-meeting report prose generation.
OPENAI_REPORT_MODEL=gpt-4o-mini

# Optional Slack webhook for report notifications.
SLACK_WEBHOOK_URL=

# Optional SendGrid email delivery for report notifications.
SENDGRID_API_KEY=
REPORT_EMAIL=
REPORT_EMAIL_FROM=

# Optional Zoom credentials. SSO or two-factor auth may still require manual intervention.
ZOOM_EMAIL=
ZOOM_PASSWORD=

# Optional Google Meet credentials for browser automation.
GOOGLE_EMAIL=
GOOGLE_PASSWORD=

# Optional Microsoft Teams credentials. SSO or MFA may still require manual intervention.
TEAMS_EMAIL=
TEAMS_PASSWORD=
